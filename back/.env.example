# JWT Configuration
# IMPORTANT: Generate long, random, cryptographically secure strings for production
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters-long

# Separate secret for signing refresh tokens — MUST be different from JWT_SECRET
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-minimum-32-characters-long

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Server Configuration
PORT=3000

# ─── Brevo (Sendinblue) email configuration ───────────────────────────────────
# Brevo's free tier allows sending to any recipient after verifying one sender.
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=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

# The single verified sender email you configured in Brevo
# (Settings → Senders & IPs → Senders — must be verified before sending)
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# Display name shown in the From field of outgoing emails
BREVO_SENDER_NAME=تاجر

# ─── Firebase Cloud Messaging (Push Notifications) ────────────────────────────
# Generate base64 string from your serviceAccountKey.json
# Mac/Linux: base64 -i serviceAccountKey.json
# Windows: certutil -encode serviceAccountKey.json temp.txt (strip headers)
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_service_account_json_here
